  {
   "id": "code-map",
   "name": "Mapear etapa y cifrar datos",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    260,
    0
   ],
   "parameters": {
    "jsCode": "const crypto = require('crypto');\n\n/**\n * Mapeo etapa CRM (valores internos Twenty) \u2192 evento Meta CAPI.\n * Etiquetas visibles pueden cambiar; los valores NEW/SCREENING/PQL/\u2026 no.\n * Todos los stages emiten evento (tambi\u00e9n NEW/SCREENING/NQL) \u2014 Conversion Leads.\n */\nconst MAPA = {\n  NEW:       { event: 'Lead',     value: 1 },\n  SCREENING: { event: 'PQL',      value: 2 },\n  PQL:       { event: 'MQL',      value: 10 },\n  MEETING:   { event: 'SQL',      value: 100 },\n  PROPOSAL:  { event: 'HOT',      value: 300 },\n  CUSTOMER:  { event: 'Purchase', value: null },\n  NQL:       { event: 'NQL',      value: 0 },\n};\n\nconst PLAN_VALUE = { VORTEX: 279, ATLAS: 379, SUMMIT: 479 };\n\nconst VENTANA_28D = 28 * 24 * 3600;\n\nconst hash = (v) => {\n  if (!v) return '';\n  return crypto.createHash('sha256').update(String(v).trim().toLowerCase()).digest('hex');\n};\n\nconst hashPhone = (numero, codigo) => {\n  const limpio = String(numero || '').replace(/\\D/g, '');\n  if (!limpio) return '';\n  const cc = String(codigo || '').replace(/\\D/g, '');\n  const completo = cc && !limpio.startsWith(cc) ? cc + limpio : limpio;\n  return crypto.createHash('sha256').update(completo).digest('hex');\n};\n\nconst ledger = $getWorkflowStaticData('global');\nconst enviados = (ledger.enviados && typeof ledger.enviados === 'object') ? ledger.enviados : {};\nconst ahora = Math.floor(Date.now() / 1000);\nconst salida = [];\n\nfor (const item of $input.all()) {\n  const cuerpo = item.json.body || item.json;\n  const registro = cuerpo.record || cuerpo.objectRecord || {};\n  const tocados = Array.isArray(cuerpo.updatedFields) ? cuerpo.updatedFields : null;\n\n  const objeto = String((cuerpo.objectMetadata || {}).nameSingular || '').toLowerCase();\n  if (objeto && objeto !== 'opportunity') {\n    salida.push({ json: { omitido: true, motivo: 'no_opportunity', objeto } });\n    continue;\n  }\n\n  const etapa = String(registro.stage || '').toUpperCase();\n  const leadgenId = registro.leadgenId ? String(registro.leadgenId) : '';\n  const oppId = registro.id ? String(registro.id) : '';\n\n  // Sin leadgenId: se env\u00eda igual, sin user_data.lead_id (no bloquear).\n\n  // Solo omitir si Twenty declara updatedFields y stage NO est\u00e1 entre ellos.\n  // Si no hay updatedFields (test manual / payload parcial), se procesa.\n  if (tocados && tocados.length && !tocados.includes('stage')) {\n    salida.push({ json: { omitido: true, motivo: 'stage_no_cambio', etapa } });\n    continue;\n  }\n\n  const meta = MAPA[etapa];\n  if (!meta) {\n    salida.push({ json: { omitido: true, motivo: 'etapa_desconocida', etapa } });\n    continue;\n  }\n\n  // Sin filtro de regresi\u00f3n: NEW/SCREENING/NQL tambi\u00e9n deben llegar a Meta\n  // (Conversion Leads necesita los negativos). Dedup = event_id + ledger.\n\n  const creadoIso = registro.horaRegistro || registro.createdAt || registro.created_at || '';\n  let creadoTs = creadoIso ? Math.floor(new Date(creadoIso).getTime() / 1000) : null;\n  if (creadoTs && (ahora - creadoTs) > VENTANA_28D) {\n    salida.push({ json: { omitido: true, motivo: 'fuera_ventana_28d', etapa, creadoIso } });\n    continue;\n  }\n\n  if (!oppId) {\n    salida.push({ json: { omitido: true, motivo: 'sin_opportunity_id', etapa } });\n    continue;\n  }\n\n  const email = String(\n    registro.pointOfContact?.emails?.primaryEmail\n    || registro.email\n    || ''\n  ).toLowerCase().trim();\n  const tel = registro.telefonoContacto?.primaryPhoneNumber\n    || registro.pointOfContact?.phones?.primaryPhoneNumber\n    || '';\n  const cc = registro.telefonoContacto?.primaryPhoneCallingCode\n    || registro.pointOfContact?.phones?.primaryPhoneCallingCode\n    || '';\n\n  const em = hash(email);\n  const ph = hashPhone(tel, cc);\n\n  const eventId = oppId + '_' + etapa;\n\n  const ledgerKey = meta.event + ':' + oppId;\n  if (enviados[ledgerKey]) {\n    salida.push({ json: { omitido: true, motivo: 'ya_enviado_ledger', ledgerKey } });\n    continue;\n  }\n\n  let value = meta.value;\n  if (meta.event === 'Purchase') {\n    const plan = String(registro.planClinera || '').toUpperCase().trim();\n    value = PLAN_VALUE[plan] != null ? PLAN_VALUE[plan] : 279;\n  }\n\n  const userData = {};\n  if (leadgenId) {\n    // entero sin hash; si no cabe en Number seguro, string\n    const n = Number(leadgenId);\n    userData.lead_id = Number.isSafeInteger(n) ? n : leadgenId;\n  }\n  if (em) userData.em = [em];\n  if (ph) userData.ph = [ph];\n\n  const customData = {\n    event_source: 'crm',\n    lead_event_source: 'Twenty CRM',\n    currency: 'USD',\n    value: value,\n    lead_stage: etapa,\n    opportunity_id: oppId,\n  };\n  if (leadgenId) customData.leadgen_id = leadgenId;\n\n  const payload = {\n    data: [{\n      event_name: meta.event,\n      event_time: ahora,\n      event_id: eventId,\n      action_source: 'system_generated',\n      user_data: userData,\n      custom_data: customData,\n    }],\n  };\n\n  salida.push({\n    json: {\n      omitido: false,\n      etapa,\n      evento: meta.event,\n      event_id: eventId,\n      leadgen_id: leadgenId || null,\n      opportunity_id: oppId,\n      ledgerKey,\n      payload,\n    },\n  });\n}\n\nreturn salida;\n"
   }
  },
