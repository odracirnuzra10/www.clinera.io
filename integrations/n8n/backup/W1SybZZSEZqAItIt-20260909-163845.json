  {
   "id": "code-confirm",
   "name": "Confirmar y auditar",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1000,
    -40
   ],
   "parameters": {
    "jsCode": "const ledger = $getWorkflowStaticData('global');\nconst enviados = (ledger.enviados && typeof ledger.enviados === 'object') ? { ...ledger.enviados } : {};\nconst preparada = $('Mapear etapa y cifrar datos').all();\nconst respuestas = $input.all();\nconst out = [];\n\nfor (let i = 0; i < respuestas.length; i++) {\n  const resp = respuestas[i].json || {};\n  const prev = (preparada[i] && preparada[i].json) || {};\n  const ok = Number(resp.events_received || 0) >= 1;\n  if (ok && prev.ledgerKey) {\n    enviados[prev.ledgerKey] = {\n      at: new Date().toISOString(),\n      event_id: prev.event_id,\n      evento: prev.evento,\n      fbtrace_id: resp.fbtrace_id || null,\n    };\n  }\n  out.push({\n    json: {\n      ok,\n      events_received: resp.events_received ?? 0,\n      mensajes: resp.messages || [],\n      fbtrace_id: resp.fbtrace_id || null,\n      event_id: prev.event_id || null,\n      evento: prev.evento || null,\n      leadgen_id: prev.leadgen_id || null,\n      opportunity_id: prev.opportunity_id || null,\n      enviado_en: new Date().toISOString(),\n    },\n  });\n}\n\nledger.enviados = enviados;\nreturn out;\n"
   }
  },
